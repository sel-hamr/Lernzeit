{
  // The Lernzeit Worker: the Vite build as static files, plus the /api routes in worker/src.
  "name": "lernzeit",
  "compatibility_date": "2026-11-01",
  "main": "worker/src/index.ts",
  "d1_databases": [
    { "binding": "DB", "database_name": "lernzeit", "database_id": "1f2d491c-82c4-49f9-9ffc-202b794776db", "migrations_dir": "worker/migrations" }
  ],
  "assets": {
    "binding": "ASSETS",
    // Only /api/* runs the Worker first; every other request is answered from dist/ directly.
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    // Client-side routes such as /flashcards get index.html instead of a 404.
    "not_found_handling": "single-page-application"
  },
  // `wrangler preview` needs this block, even empty; it uses the settings above.
  "previews": {}
}
