{
  // Cloudflare serves the Vite build as static files; the app has no server code.
  "name": "lernzeit",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes such as /flashcards get index.html instead of a 404.
    "not_found_handling": "single-page-application"
  },
  // `wrangler preview` needs this block, even empty; it uses the settings above.
  "previews": {}
}
